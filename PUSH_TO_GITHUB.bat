@echo off
chcp 65001 >nul
title رفع التحديثات إلى GitHub (Deploy to GitHub)
echo ============================================================
echo   🚀 جاري رفع آخر تحديثات وإصلاحات اللعبة إلى GitHub...
echo ============================================================
echo.

cd /d "%~dp0"

git push -u origin main --force

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ============================================================
    echo ✅ تم رفع جميع الملفات والتحديثات إلى GitHub بنجاح!
    echo 🌐 خادم Render سيبدأ النشر التلقائي (Auto Deploy) فوراً.
    echo ============================================================
) else (
    echo.
    echo ⚠️ حدث تنبيه من GitHub: يرجى الضغط على Authorize في نافذة المتصفح للموافقة على الرفع.
)

echo.
pause
